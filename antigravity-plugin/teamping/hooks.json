{
  "teamping": {
    "SessionStart": [
      { "type": "command", "command": "node ./scripts/lock.mjs sessionStart", "timeout": 6 }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [{ "type": "command", "command": "node ./scripts/lock.mjs preToolUse", "timeout": 6 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|call_mcp_tool",
        "hooks": [{ "type": "command", "command": "node ./scripts/lock.mjs postToolUse", "timeout": 6 }]
      }
    ]
  }
}
