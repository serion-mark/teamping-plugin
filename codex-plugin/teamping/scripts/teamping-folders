#!/usr/bin/env python3
"""Manage explicit recording roots. Never changes Codex connection settings."""
import importlib.util
from pathlib import Path

spec = importlib.util.spec_from_file_location('teamping_folders', Path(__file__).resolve().with_name('folder_context.py'))
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
raise SystemExit(module.main())
